# ============================================================
# CosplayHub — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/
.env/
.env
.env.local

# Flask instance folder (contains the SQLite .db file and secret configs)
instance/

# OS
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Node (legacy prototype)
node_modules/

# Uploads (user-generated content — not committed)
static/uploads/*
!static/uploads/.gitkeep
